# LoadOut private data -------------------------------------------------------
# Runtime records can contain home locations, travel dates, booking details,
# wardrobe contents, and movement history. Keep the reusable schema/rules and
# sanitized examples; ignore every real runtime record by default.
/data/*
!/data/schema.yaml
!/data/categories.yaml
!/data/activity_templates.yaml
!/data/requirement_matchers.yaml
!/data/examples/
!/data/examples/*.yaml

# Legacy/private inventory sources and personalized fixtures/documentation.
/inventory
/markdown_data/
/tests/test_api.py
/tests/test_inventory.py
/docs/packing-planning.md
/docs/trip-execution.md
/docs/trip-planning.md

# Common places for personal travel exports and attachments.
/private/
/personal/
/bookings/
/receipts/
/attachments/
/exports/
*.pkpass
*.ics
*boarding-pass*
*boarding_pass*
*booking-confirmation*
*booking_confirmation*
*reservation-confirmation*
*reservation_confirmation*
*travel-itinerary*
*travel_itinerary*

# Local secrets and environment overrides.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

